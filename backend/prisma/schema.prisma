datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  passwordHash String
  name         String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  cards        Card[]
  transactions Transaction[]
  contacts     Contact[]
  bankAccounts BankAccount[]
}

enum CardType {
  VIRTUAL
  PHYSICAL
}

enum CardVariant {
  BLUE
  PURPLE
  GREEN
  OBSIDIAN
}

model Card {
  id         String      @id @default(cuid())
  userId     String
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       CardType
  currency   String      @default("USD")
  balance    Decimal     @default(0) @db.Decimal(18, 2)
  lastFour   String
  variant    CardVariant @default(BLUE)
  fullNumber String      @db.VarChar(19)
  expiry     String      @db.VarChar(5)
  cvv        String      @db.VarChar(4)
  createdAt  DateTime    @default(now())

  @@index([userId])
}

enum TxnType {
  SEND
  RECEIVE
  TOPUP
  WITHDRAW
}

enum TxnStatus {
  PENDING
  COMPLETED
  FAILED
}

model Transaction {
  id               String       @id @default(cuid())
  userId           String
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  type             TxnType
  amount           Decimal      @db.Decimal(18, 2)
  currency         String       @default("USD")
  counterpartyName String?
  status           TxnStatus    @default(COMPLETED)
  bankAccountId    String?
  bankAccount      BankAccount? @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)
  createdAt        DateTime     @default(now())

  @@index([userId, createdAt])
  @@index([bankAccountId])
}

enum BankAccountType {
  CHECKING
  SAVINGS
}

model BankAccount {
  id              String          @id @default(cuid())
  userId          String
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  institutionId   String
  institutionName String
  logoColor       String
  logoLetter      String          @db.VarChar(2)
  accountType     BankAccountType @default(CHECKING)
  lastFour        String          @db.VarChar(4)
  isPrimary       Boolean         @default(false)
  createdAt       DateTime        @default(now())
  transactions    Transaction[]

  @@index([userId])
}

model Contact {
  id          String @id @default(cuid())
  userId      String
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  handle      String
  initials    String
  accentColor String

  @@index([userId])
}
