# MySQL container credentials (used by docker-compose)
MYSQL_ROOT_PASSWORD=changeme_root
MYSQL_DATABASE=emmapay
MYSQL_USER=emmapay
MYSQL_PASSWORD=changeme

# Used by `prisma migrate dev` from your host machine (host -> exposed 3306).
# Inside the docker network, docker-compose overrides this to use hostname "mysql".
DATABASE_URL=mysql://emmapay:changeme@localhost:3306/emmapay

# Replace with a long random string before running anywhere real.
JWT_SECRET=replace_with_a_long_random_string_at_least_32_chars

# Optional overrides
PORT=3000
NODE_ENV=development
